{"run_id":"1795052735-169511807","line":2621,"new":{"module_name":"verus_consistency","snapshot_name":"verus_encapsulates_and_closure_no_unwind","metadata":{"source":"tests/verus-consistency.rs","assertion_line":2621,"expression":"parse_and_format(file).unwrap()"},"snapshot":"verus! {\n\nimpl Pool {\n    fn alloc(&mut self) -> (r: u64)\n        encapsulates\n            alloc(1, 0),\n    {\n        self.n\n    }\n\n    fn cond(&mut self, k: u64)\n        ensures\n            true,\n        encapsulates\n            alloc(\n                0,\n                if k > 10 {\n                    1\n                } else {\n                    0\n                },\n            ),\n    {\n    }\n\n    fn both()\n        no_unwind\n        allocates\n            1,\n    {\n    }\n}\n\npub assume_specification[ ext_free ](x: u64)\n    encapsulates\n        alloc(0, 1),\n;\n\nfn closures(f: F) -> u64\n    requires\n        !f.unwinds(1),\n{\n    let lim = 10u64;\n    let a = |y: u64| -> (r: u64)\n        no_unwind\n        { y / 2 };\n    let b = |y: u64| -> (r: u64)\n        no_unwind when y < lim\n        { y };\n    let c = |y: u64| -> (r: u64)\n        ensures\n            r == y,\n        no_unwind\n        allocates\n            0,\n        { y };\n    a(1)\n}\n\n} // verus!"},"old":{"module_name":"verus_consistency","metadata":{},"snapshot":"PLACEHOLDER"}}
